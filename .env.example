# ─────────────────────────────────────────────
# AI-Screening Enginee — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Gemini AI API Key ─────────────────────────
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Qdrant Cloud (Free Tier) ──────────────────
# Sign up free at: https://cloud.qdrant.io
# 1. Create a free cluster
# 2. Copy the cluster URL  → paste as QDRANT_URL
# 3. Create an API Key    → paste as QDRANT_API_KEY
QDRANT_URL=https://your-cluster-xxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_api_key_here

# ── Leave blank to use local disk storage ─────
# QDRANT_URL=
# QDRANT_API_KEY=

# ── Supabase PostgreSQL (Free Tier) ───────────
# Sign up free at: https://supabase.com
# 1. Create a new project
# 2. Go to Settings → API
# 3. Copy Project URL   → paste as SUPABASE_URL
# 4. Copy service_role key → paste as SUPABASE_KEY (keep secret!)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_service_role_key_here
